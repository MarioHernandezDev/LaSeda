{"file":"terapias-3ehTarpL.js","mappings":";;;;;;;;;;;;;;;;;;AA0fA,UAAM,OAAO;AAAA,MACX;AAAA,QACE,GAAG;AAAA,QACH,GAAG;AAAA,MACP;AAAA,MACE;AAAA,QACE,GAAG;AAAA,QACH,GAAG;AAAA,MACP;AAAA,MACE;AAAA,QACE,GAAG;AAAA,QACH,GAAG;AAAA,MACP;AAAA,MACE;AAAA,QACE,GAAG;AAAA,QACH,GAAG;AAAA,MACP;AAAA,MACE;AAAA,QACE,GAAG;AAAA,QACH,GAAG;AAAA,MACP;AAAA,IACA;AAEA,eAAW;AAAA,MACT,OAAO;AAAA,MACP,aACE;AAAA,MACF,SAAS;AAAA,MACT,eACE;AAAA,MACF,SAAS;AAAA,MACT,QAAQ;AAAA,MACR,QAAQ;AAAA,IACV,CAAC;AAED,YAAQ;AAAA,MACN,QAAQ;AAAA,QACN;AAAA,UACE,MAAM;AAAA,UACN,WAAW,KAAK,UAAU;AAAA,YACxB,YAAY;AAAA,YACZ,SAAS;AAAA,YACT,YAAY;AAAA,cACV;AAAA,gBACE,SAAS;AAAA,gBACT,MAAM;AAAA,gBACN,gBAAgB;AAAA,kBACd,SAAS;AAAA,kBACT,MAAM;AAAA,gBACpB;AAAA,cACA;AAAA,cACU;AAAA,gBACE,SAAS;AAAA,gBACT,MAAM;AAAA,gBACN,gBAAgB;AAAA,kBACd,SAAS;AAAA,kBACT,MAAM;AAAA,gBACpB;AAAA,cACA;AAAA,cACU;AAAA,gBACE,SAAS;AAAA,gBACT,MAAM;AAAA,gBACN,gBAAgB;AAAA,kBACd,SAAS;AAAA,kBACT,MAAM;AAAA,gBACpB;AAAA,cACA;AAAA,YACA;AAAA,UACA,CAAO;AAAA,QACP;AAAA,MACA;AAAA,IACA,CAAC;;;AAhkBO,YAAA,QAAAA,eAAAC,WAAA,EAAA,OAAM,6DAAyD,MAAA,CAAA,CAAA,m+HAAA;AAiHnCC,oBAAA,CAAA,qBAAA,aAAA,SAAA,cAAA,qBAAA,SAAA,IAAP,QAAG;2IAGZ,GAAG,CAAA,SAAA;AAAA;;;QAQP,IAAG;AAAA,QACH,OAAM;AAAA;yBAFR,CAQW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BALV,qBAEC;AAAA,4BAAAC,YAEM,OAAA;AAAA,gBAFD,OAAM;AAAA,gBAA+D,MAAK;AAAA,gBAAO,QAAO;AAAA,gBAAe,SAAQ;AAAA;gBAClHC,YAAoG,QAAA;AAAA,kBAA9F,kBAAe;AAAA,kBAAQ,mBAAgB;AAAA,kBAAQ,gBAAa;AAAA,kBAAI,GAAE;AAAA;;;;;;;;AAwCtDJ,oBAAA,CAAA,QAAA,oBAAA,uBAAA,YAAA,mBAAA,cAAA,IAAP,QAAG;2IAGZ,GAAG,CAAA,SAAA;AAAA;;;QAQP,IAAG;AAAA,QACH,OAAM;AAAA;yBAFR,CAQW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BALV,cAEC;AAAA,4BAAAC,YAEM,OAAA;AAAA,gBAFD,OAAM;AAAA,gBAAc,MAAK;AAAA,gBAAO,QAAO;AAAA,gBAAe,SAAQ;AAAA;gBACjEC,YAAoG,QAAA;AAAA,kBAA9F,kBAAe;AAAA,kBAAQ,mBAAgB;AAAA,kBAAQ,gBAAa;AAAA,kBAAI,GAAE;AAAA;;;;;;;;AAiEtDJ,oBAAA,CAAA,oBAAA,gBAAA,eAAA,sBAAA,mBAAA,YAAA,IAAP,QAAG;2IAGZ,GAAG,CAAA,SAAA;AAAA;;;QAQP,IAAG;AAAA,QACH,OAAM;AAAA;yBAFR,CAQW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BALV,qBAEC;AAAA,4BAAAC,YAEM,OAAA;AAAA,gBAFD,OAAM;AAAA,gBAAc,MAAK;AAAA,gBAAO,QAAO;AAAA,gBAAe,SAAQ;AAAA;gBACjEC,YAAoG,QAAA;AAAA,kBAA9F,kBAAe;AAAA,kBAAQ,mBAAgB;AAAA,kBAAQ,gBAAa;AAAA,kBAAI,GAAE;AAAA;;;;;;;;AAsDtDJ,oBAAA,CAAA,wBAAA,sBAAA,oBAAA,2BAAA,cAAA,yBAAA,IAAP,QAAG;6JAGZ,GAAG,CAAA,SAAA;AAAA;;;QAOP,IAAG;AAAA,QACH,OAAM;AAAA;yBAFR,CAQW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BALV,mBAEC;AAAA,4BAAAC,YAEM,OAAA;AAAA,gBAFD,OAAM;AAAA,gBAAc,MAAK;AAAA,gBAAO,QAAO;AAAA,gBAAe,SAAQ;AAAA;gBACjEC,YAAoG,QAAA;AAAA,kBAA9F,kBAAe;AAAA,kBAAQ,mBAAgB;AAAA,kBAAQ,gBAAa;AAAA,kBAAI,GAAE;AAAA;;;;;;;;QAI1E,IAAG;AAAA,QACH,OAAM;AAAA;yBAFR,CAKW,GAAAH,QAAAC,UAAA,aAAA;;;;;8BAFV,iCAED;AAAA;;;;;;oBA8FkB,MAAI,CAAhB,MAAM,MAAC;8PAMRG,eAAA,KAAK,CAAC,siBASRA,eAAA,KAAK,CAAC;;;;QA8BX,IAAG;AAAA,QACH,OAAM;AAAA;yBAFR,CASW,GAAAJ,QAAAC,UAAA,aAAA;;;;;4BALTC,YAGM,OAAA;AAAA,gBAHD,OAAM;AAAA,gBAAU,MAAK;AAAA,gBAAO,QAAO;AAAA,gBAAe,SAAQ;AAAA;gBAC7DC,YAC8F,QAAA;AAAA,kBADxF,kBAAe;AAAA,kBAAQ,mBAAgB;AAAA,kBAAQ,gBAAa;AAAA,kBAChE,GAAE;AAAA;;8BACA,yBAER;AAAA;;;;;;QAEE,IAAG;AAAA,QACH,OAAM;AAAA;yBAFR,CAKW,GAAAH,QAAAC,UAAA,aAAA;;;;;8BAFV,qBAED;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderList","_push","_parent","_createBlock","_createVNode","_ssrInterpolate"],"sources":["../../../../../../../app/pages/terapias.vue"],"sourcesContent":["<template>\n  <main class=\"bg-[#FDFBF9] text-[#27252B] font-sans overflow-x-hidden\">\n\n    <!-- ============================================================\n         1. HERO INTRODUCTORIO\n    ============================================================ -->\n    <section aria-labelledby=\"terapias-titulo\" class=\"relative pt-20 md:pt-28 pb-0 overflow-hidden\">\n\n      <!-- Fondo con mancha orgánica decorativa -->\n      <div\n        class=\"absolute top-0 right-0 w-[45vw] h-[45vw] max-w-[600px] max-h-[600px] rounded-full opacity-[0.04] bg-[#71B1A5] blur-3xl pointer-events-none -translate-y-1/4 translate-x-1/4\"\n      ></div>\n\n      <div class=\"max-w-7xl mx-auto px-8 md:px-16 lg:px-24\">\n\n        <div class=\"grid md:grid-cols-[1fr_1fr] gap-12 lg:gap-20 items-end pb-16 md:pb-20\">\n\n          <!-- Columna izquierda: título -->\n          <div>\n            <div class=\"flex items-center gap-3 mb-8\">\n              <div class=\"w-8 h-px bg-[#71B1A5]\"></div>\n              <span class=\"text-[#71B1A5] text-xs tracking-[0.3em] uppercase font-light\">\n                Área Clínica\n              </span>\n            </div>\n\n            <h1 id=\"terapias-titulo\" class=\"font-serif text-4xl md:text-5xl lg:text-[3.25rem] leading-[1.08] text-[#27252B]\">\n              Psicoterapia y<br/>\n              especialidades clínicas\n              <span class=\"italic text-[#71B1A5] block mt-2\">en Granada</span>\n            </h1>\n          </div>\n\n          <!-- Columna derecha: texto introductorio -->\n          <div class=\"md:pb-3\">\n            <p class=\"text-[#27252B]/60 text-[1rem] leading-relaxed font-light mb-6\">\n              No existe una sola manera de hacer psicología. En La Seda integramos los enfoques con\n              mayor respaldo científico —<strong class=\"text-[#27252B]/80 font-medium\">cognitivo-conductual</strong>,\n              <strong class=\"text-[#27252B]/80 font-medium\">sistémico</strong> y\n              <strong class=\"text-[#27252B]/80 font-medium\">humanista-existencial</strong>— y los adaptamos\n              a la realidad concreta de cada persona, sin protocolos rígidos ni soluciones de talla única.\n            </p>\n            <p class=\"text-[#27252B]/60 text-[1rem] leading-relaxed font-light\">\n              El primer paso es escucharte. A partir de ahí, construimos juntos un camino terapéutico\n              con objetivos claros, un ritmo adecuado a tu momento vital y un profesional que te acompañe\n              de verdad en cada etapa del proceso.\n            </p>\n          </div>\n        </div>\n\n        <!-- Línea divisoria con ornamento -->\n        <div class=\"flex items-center gap-5\">\n          <div class=\"h-px flex-1 bg-[#27252B]/8\"></div>\n          <div class=\"flex gap-1.5\">\n            <div class=\"w-1 h-1 rounded-full bg-[#71B1A5]/40\"></div>\n            <div class=\"w-1 h-1 rounded-full bg-[#71B1A5]\"></div>\n            <div class=\"w-1 h-1 rounded-full bg-[#71B1A5]/40\"></div>\n          </div>\n          <div class=\"h-px w-12 bg-[#27252B]/8\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============================================================\n         2. GRID DE MODALIDADES — cuatro terapias\n    ============================================================ -->\n    <section aria-label=\"Especialidades terapéuticas\" class=\"py-16 md:py-24 px-8 md:px-16 lg:px-24\">\n      <div class=\"max-w-7xl mx-auto space-y-6 md:space-y-8\">\n\n        <!-- ══════════════════════════════════════════════════════\n             TERAPIA 1 — ADULTOS\n             Layout: imagen izquierda · contenido derecha\n        ═══════════════════════════════════════════════════════ -->\n        <article\n          id=\"adultos\"\n          class=\"group grid md:grid-cols-[5fr_7fr] overflow-hidden bg-white border border-[#27252B]/8 hover:border-[#71B1A5]/30 hover:shadow-2xl hover:shadow-[#71B1A5]/8 transition-all duration-500\"\n        >\n          <!-- Imagen -->\n          <div class=\"relative overflow-hidden aspect-[4/3] md:aspect-auto min-h-[260px]\">\n            <img\n              src=\"https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=900&q=88&auto=format&fit=crop\"\n              alt=\"Terapia psicológica para adultos en Granada — ansiedad, estrés y bienestar emocional\"\n              class=\"absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700\"\n              loading=\"lazy\"\n            />\n            <!-- Número decorativo -->\n            <div class=\"absolute bottom-5 left-5 font-serif text-white/20 text-7xl leading-none select-none\">01</div>\n            <!-- Badge -->\n            <div class=\"absolute top-5 left-5 bg-[#71B1A5] text-white text-[10px] tracking-[0.22em] uppercase px-3.5 py-2 font-medium\">\n              Adultos\n            </div>\n          </div>\n\n          <!-- Contenido -->\n          <div class=\"flex flex-col justify-between p-8 md:p-10 lg:p-12\">\n            <div>\n              <h2 class=\"font-serif text-2xl md:text-3xl text-[#27252B] leading-tight mb-4 group-hover:text-[#27252B] transition-colors\">\n                Terapia Individual para Adultos\n              </h2>\n\n              <p class=\"text-[#27252B]/60 text-sm leading-relaxed font-light mb-6\">\n                La vida adulta trae consigo una complejidad que a veces desborda nuestros recursos internos.\n                Ansiedad, depresión, duelos, bloqueos emocionales, insatisfacción vital, problemas de autoestima\n                o dificultades en las relaciones: estos son algunos de los motivos más frecuentes por los que\n                las personas acuden a consulta en La Seda.\n              </p>\n              <p class=\"text-[#27252B]/60 text-sm leading-relaxed font-light mb-8\">\n                Trabajamos con un modelo integrativo que parte siempre de la persona concreta que tienes delante,\n                no de un diagnóstico. El objetivo no es solo aliviar el malestar: es construir una relación\n                más sana contigo mismo y con el mundo que te rodea.\n              </p>\n\n              <!-- Indicaciones -->\n              <div class=\"flex flex-wrap gap-2 mb-8\">\n                <span v-for=\"tag in ['Ansiedad y estrés', 'Depresión', 'Duelo', 'Autoestima', 'Gestión emocional', 'Burnout']\"\n                  :key=\"tag\"\n                  class=\"text-[10px] tracking-widest uppercase bg-[#71B1A5]/10 text-[#71B1A5] px-3 py-1.5 font-medium\"\n                >{{ tag }}</span>\n              </div>\n            </div>\n\n            <!-- CTA -->\n            <div class=\"flex items-center justify-between pt-6 border-t border-[#27252B]/8\">\n              <p class=\"text-xs text-[#27252B]/35 font-light\">Modalidad presencial y online</p>\n              <NuxtLink\n                to=\"/contacto?servicio=adultos\"\n                class=\"inline-flex items-center gap-2.5 bg-[#27252B] text-white text-xs tracking-[0.18em] uppercase font-medium px-7 py-3.5 hover:bg-[#71B1A5] transition-all duration-300\"\n              >\n                Reservar consulta\n                <svg class=\"w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n                </svg>\n              </NuxtLink>\n            </div>\n          </div>\n        </article>\n\n        <!-- ══════════════════════════════════════════════════════\n             TERAPIA 2 — INFANTO-JUVENIL\n             Layout: contenido izquierda · imagen derecha (invertido)\n        ═══════════════════════════════════════════════════════ -->\n        <article\n          id=\"infanto-juvenil\"\n          class=\"group grid md:grid-cols-[7fr_5fr] overflow-hidden bg-[#27252B] border border-transparent hover:border-[#71B1A5]/25 hover:shadow-2xl transition-all duration-500\"\n        >\n          <!-- Contenido -->\n          <div class=\"flex flex-col justify-between p-8 md:p-10 lg:p-12 order-2 md:order-1\">\n            <div>\n              <div class=\"flex items-center gap-3 mb-6\">\n                <div class=\"w-5 h-px bg-[#71B1A5]\"></div>\n                <span class=\"text-[#71B1A5] text-[10px] tracking-[0.28em] uppercase font-light\">Especialidad</span>\n              </div>\n\n              <h2 class=\"font-serif text-2xl md:text-3xl text-white leading-tight mb-4\">\n                Terapia Infanto-Juvenil\n              </h2>\n\n              <p class=\"text-white/55 text-sm leading-relaxed font-light mb-6\">\n                La infancia y la adolescencia son etapas de una sensibilidad extraordinaria. Las heridas emocionales\n                de estos años —aunque a menudo invisibles para los adultos— dejan huellas profundas. En La Seda\n                acompañamos a niños y jóvenes con un enfoque adaptado a su edad, su lenguaje y su mundo.\n              </p>\n              <p class=\"text-white/55 text-sm leading-relaxed font-light mb-8\">\n                Trabajamos también con las familias como sistema: a veces el síntoma del niño es el mensaje\n                de un conjunto relacional que necesita ser escuchado. Nuestra intervención contempla siempre\n                el entorno escolar, familiar y social del menor.\n              </p>\n\n              <!-- Indicaciones -->\n              <div class=\"flex flex-wrap gap-2 mb-8\">\n                <span v-for=\"tag in ['TDAH', 'Ansiedad escolar', 'Heridas emocionales', 'Bullying', 'Neurodesarrollo', 'Adolescencia']\"\n                  :key=\"tag\"\n                  class=\"text-[10px] tracking-widest uppercase bg-[#71B1A5]/15 text-[#71B1A5] px-3 py-1.5 font-medium\"\n                >{{ tag }}</span>\n              </div>\n            </div>\n\n            <!-- CTA -->\n            <div class=\"flex items-center justify-between pt-6 border-t border-white/10\">\n              <p class=\"text-xs text-white/30 font-light\">Evaluación previa sin coste</p>\n              <NuxtLink\n                to=\"/contacto?servicio=infanto-juvenil\"\n                class=\"inline-flex items-center gap-2.5 bg-[#71B1A5] text-white text-xs tracking-[0.18em] uppercase font-medium px-7 py-3.5 hover:bg-[#5a9a8e] transition-all duration-300\"\n              >\n                Informarse\n                <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n                </svg>\n              </NuxtLink>\n            </div>\n          </div>\n\n          <!-- Imagen -->\n          <div class=\"relative overflow-hidden aspect-[4/3] md:aspect-auto min-h-[260px] order-1 md:order-2\">\n            <img\n              src=\"https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=900&q=88&auto=format&fit=crop\"\n              alt=\"Terapia psicológica infanto-juvenil en Granada — niños y adolescentes\"\n              class=\"absolute inset-0 w-full h-full object-cover object-center opacity-75 group-hover:scale-105 transition-transform duration-700\"\n              loading=\"lazy\"\n            />\n            <div class=\"absolute inset-0 bg-gradient-to-r from-[#27252B]/60 via-transparent to-transparent\"></div>\n            <div class=\"absolute bottom-5 right-5 font-serif text-white/15 text-7xl leading-none select-none\">02</div>\n            <div class=\"absolute top-5 right-5 bg-white/10 backdrop-blur-sm text-white text-[10px] tracking-[0.22em] uppercase px-3.5 py-2 font-medium border border-white/15\">\n              Infanto-Juvenil\n            </div>\n          </div>\n        </article>\n\n        <!-- ══════════════════════════════════════════════════════\n             TERAPIA 3 — PAREJA Y FAMILIA\n             Layout: dos mitades simétricas\n        ═══════════════════════════════════════════════════════ -->\n        <article\n          id=\"pareja\"\n          class=\"group grid md:grid-cols-[5fr_7fr] overflow-hidden bg-white border border-[#27252B]/8 hover:border-[#71B1A5]/30 hover:shadow-2xl hover:shadow-[#71B1A5]/8 transition-all duration-500\"\n        >\n          <!-- Imagen -->\n          <div class=\"relative overflow-hidden aspect-[4/3] md:aspect-auto min-h-[260px]\">\n            <img\n              src=\"https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?w=900&q=88&auto=format&fit=crop\"\n              alt=\"Terapia de pareja y familiar en Granada — comunicación, vínculos y resolución de conflictos\"\n              class=\"absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700\"\n              loading=\"lazy\"\n            />\n            <div class=\"absolute bottom-5 left-5 font-serif text-white/20 text-7xl leading-none select-none\">03</div>\n            <div class=\"absolute top-5 left-5 bg-[#71B1A5] text-white text-[10px] tracking-[0.22em] uppercase px-3.5 py-2 font-medium\">\n              Pareja · Familia\n            </div>\n          </div>\n\n          <!-- Contenido -->\n          <div class=\"flex flex-col justify-between p-8 md:p-10 lg:p-12\">\n            <div>\n              <h2 class=\"font-serif text-2xl md:text-3xl text-[#27252B] leading-tight mb-4\">\n                Terapia de Pareja y Familiar\n              </h2>\n\n              <p class=\"text-[#27252B]/60 text-sm leading-relaxed font-light mb-6\">\n                Las relaciones son el territorio más fértil para el crecimiento personal y también\n                el escenario donde más sufrimos. La terapia de pareja y familiar no busca decidir\n                quién tiene razón: busca crear un espacio seguro donde lo que no puede decirse\n                en casa pueda por fin ser dicho y escuchado.\n              </p>\n              <p class=\"text-[#27252B]/60 text-sm leading-relaxed font-light mb-8\">\n                Trabajamos con el modelo sistémico y técnicas de comunicación no violenta para\n                que la pareja o la familia pueda identificar sus patrones relacionales, romper\n                ciclos repetitivos y construir vínculos más sanos y conscientes.\n              </p>\n\n              <!-- Indicaciones -->\n              <div class=\"flex flex-wrap gap-2 mb-8\">\n                <span v-for=\"tag in ['Crisis de pareja', 'Comunicación', 'Infidelidad', 'Conflicto familiar', 'Co-parentalidad', 'Separación']\"\n                  :key=\"tag\"\n                  class=\"text-[10px] tracking-widest uppercase bg-[#71B1A5]/10 text-[#71B1A5] px-3 py-1.5 font-medium\"\n                >{{ tag }}</span>\n              </div>\n            </div>\n\n            <!-- CTA -->\n            <div class=\"flex items-center justify-between pt-6 border-t border-[#27252B]/8\">\n              <p class=\"text-xs text-[#27252B]/35 font-light\">Primera sesión de orientación conjunta</p>\n              <NuxtLink\n                to=\"/contacto?servicio=pareja\"\n                class=\"inline-flex items-center gap-2.5 bg-[#27252B] text-white text-xs tracking-[0.18em] uppercase font-medium px-7 py-3.5 hover:bg-[#71B1A5] transition-all duration-300\"\n              >\n                Reservar consulta\n                <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n                </svg>\n              </NuxtLink>\n            </div>\n          </div>\n        </article>\n\n        <!-- ══════════════════════════════════════════════════════\n             TERAPIA 4 — CONSTELACIONES FAMILIARES\n             Layout: imagen fondo completo + overlay editorial\n        ═══════════════════════════════════════════════════════ -->\n        <article\n          id=\"constelaciones\"\n          class=\"group relative overflow-hidden min-h-[420px] md:min-h-[480px] flex flex-col md:flex-row hover:shadow-2xl transition-shadow duration-500\"\n        >\n          <!-- Imagen de fondo a pantalla completa -->\n          <div class=\"absolute inset-0\">\n            <img\n              src=\"https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?w=1400&q=85&auto=format&fit=crop\"\n              alt=\"Constelaciones Familiares en Granada — sesiones individuales y grupales en La Seda\"\n              class=\"w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700\"\n              loading=\"lazy\"\n            />\n            <div class=\"absolute inset-0 bg-gradient-to-r from-[#27252B]/92 via-[#27252B]/75 to-[#27252B]/30\"></div>\n          </div>\n\n          <!-- Contenido sobre el overlay -->\n          <div class=\"relative z-10 flex flex-col justify-between p-8 md:p-12 lg:p-14 md:max-w-[60%]\">\n            <div>\n              <!-- Badge especial -->\n              <div class=\"inline-flex items-center gap-3 mb-8\">\n                <div class=\"w-5 h-px bg-[#71B1A5]\"></div>\n                <span class=\"text-[#71B1A5] text-[10px] tracking-[0.28em] uppercase font-light\">Enfoque profundo</span>\n              </div>\n\n              <h2 class=\"font-serif text-2xl md:text-3xl lg:text-4xl text-white leading-tight mb-5\">\n                Constelaciones Familiares\n                <span class=\"italic text-[#71B1A5] block mt-1\">individuales</span>\n              </h2>\n\n              <p class=\"text-white/60 text-sm leading-relaxed font-light mb-5\">\n                Las Constelaciones Familiares —desarrolladas por Bert Hellinger y profundizadas por Claudio\n                Naranjo entre otros— revelan las dinámicas sistémicas que operan en nuestra familia de origen\n                y que, sin que lo sepamos, influyen en nuestra vida cotidiana: relaciones, salud,\n                trabajo y decisiones.\n              </p>\n              <p class=\"text-white/60 text-sm leading-relaxed font-light mb-8\">\n                En La Seda ofrecemos sesiones de constelación individual —sin necesidad de grupo—\n                como herramienta terapéutica complementaria o autónoma para abordar bloqueos,\n                lealtades inconscientes y patrones heredados que resisten otros abordajes.\n              </p>\n\n              <!-- Indicaciones -->\n              <div class=\"flex flex-wrap gap-2 mb-10\">\n                <span v-for=\"tag in ['Dinámicas familiares', 'Patrones heredados', 'Bloqueos vitales', 'Duelo transgeneracional', 'Relaciones', 'Lealtades inconscientes']\"\n                  :key=\"tag\"\n                  class=\"text-[10px] tracking-widest uppercase bg-white/10 text-white/70 px-3 py-1.5 font-medium border border-white/10\"\n                >{{ tag }}</span>\n              </div>\n            </div>\n\n            <!-- CTA -->\n            <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-4\">\n              <NuxtLink\n                to=\"/contacto?servicio=constelaciones\"\n                class=\"inline-flex items-center gap-2.5 bg-[#71B1A5] text-white text-xs tracking-[0.18em] uppercase font-medium px-7 py-3.5 hover:bg-[#5a9a8e] transition-all duration-300\"\n              >\n                Reservar sesión\n                <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n                </svg>\n              </NuxtLink>\n              <NuxtLink\n                to=\"/talleres\"\n                class=\"text-xs text-white/45 tracking-widest uppercase font-light hover:text-white/80 transition-colors duration-300 border-b border-white/20 pb-0.5 hover:border-white/60\"\n              >\n                Ver también talleres grupales\n              </NuxtLink>\n            </div>\n          </div>\n\n          <!-- Número decorativo flotante derecha -->\n          <div class=\"absolute bottom-6 right-8 font-serif text-white/10 text-8xl leading-none select-none hidden md:block\">04</div>\n        </article>\n\n      </div>\n    </section>\n\n    <!-- ============================================================\n         BLOQUE PROCESO — Cómo es la primera consulta\n    ============================================================ -->\n    <section aria-labelledby=\"proceso-titulo\" class=\"py-20 md:py-28 bg-stone-100/60 px-8 md:px-16 lg:px-24\">\n      <div class=\"max-w-7xl mx-auto\">\n\n        <div class=\"flex items-center gap-3 mb-12\">\n          <div class=\"w-6 h-px bg-[#71B1A5]\"></div>\n          <h2 id=\"proceso-titulo\" class=\"font-serif text-3xl md:text-4xl text-[#27252B]\">\n            Cómo es el proceso terapéutico\n          </h2>\n        </div>\n\n        <div class=\"grid md:grid-cols-4 gap-0 relative\">\n          <!-- Línea conectora horizontal (escritorio) -->\n          <div class=\"hidden md:block absolute top-8 left-[12.5%] right-[12.5%] h-px bg-[#71B1A5]/20 z-0\"></div>\n\n          <!-- Paso 1 -->\n          <div class=\"relative z-10 flex flex-col items-start md:items-center md:text-center p-6 md:px-8 border-l md:border-l-0 md:border-t-0 border-[#71B1A5]/20 md:border-none pl-8 md:pl-6 mb-8 md:mb-0\">\n            <div class=\"w-14 h-14 rounded-full bg-white border-2 border-[#71B1A5]/30 flex items-center justify-center mb-5 flex-shrink-0 shadow-sm\">\n              <span class=\"font-serif text-[#71B1A5] text-xl leading-none\">1</span>\n            </div>\n            <h3 class=\"font-serif text-lg text-[#27252B] mb-2\">Primera consulta</h3>\n            <p class=\"text-[#27252B]/50 text-xs leading-relaxed font-light\">\n              Una sesión de orientación para conocernos, escucharte y evaluar juntos qué tipo de acompañamiento\n              se adapta mejor a tu situación.\n            </p>\n          </div>\n\n          <!-- Paso 2 -->\n          <div class=\"relative z-10 flex flex-col items-start md:items-center md:text-center p-6 md:px-8 border-l md:border-none border-[#71B1A5]/20 pl-8 md:pl-6 mb-8 md:mb-0\">\n            <div class=\"w-14 h-14 rounded-full bg-[#71B1A5] flex items-center justify-center mb-5 flex-shrink-0 shadow-md shadow-[#71B1A5]/25\">\n              <span class=\"font-serif text-white text-xl leading-none\">2</span>\n            </div>\n            <h3 class=\"font-serif text-lg text-[#27252B] mb-2\">Evaluación y acuerdo</h3>\n            <p class=\"text-[#27252B]/50 text-xs leading-relaxed font-light\">\n              Establecemos una formulación del caso y un plan de trabajo consensuado:\n              frecuencia, objetivos y las herramientas que usaremos.\n            </p>\n          </div>\n\n          <!-- Paso 3 -->\n          <div class=\"relative z-10 flex flex-col items-start md:items-center md:text-center p-6 md:px-8 border-l md:border-none border-[#71B1A5]/20 pl-8 md:pl-6 mb-8 md:mb-0\">\n            <div class=\"w-14 h-14 rounded-full bg-white border-2 border-[#71B1A5]/30 flex items-center justify-center mb-5 flex-shrink-0 shadow-sm\">\n              <span class=\"font-serif text-[#71B1A5] text-xl leading-none\">3</span>\n            </div>\n            <h3 class=\"font-serif text-lg text-[#27252B] mb-2\">Proceso terapéutico</h3>\n            <p class=\"text-[#27252B]/50 text-xs leading-relaxed font-light\">\n              Sesiones regulares donde trabajamos en profundidad. Revisamos avances,\n              ajustamos el enfoque y celebramos los cambios que vas integrando.\n            </p>\n          </div>\n\n          <!-- Paso 4 -->\n          <div class=\"relative z-10 flex flex-col items-start md:items-center md:text-center p-6 md:px-8 border-l md:border-none border-[#71B1A5]/20 pl-8 md:pl-6\">\n            <div class=\"w-14 h-14 rounded-full bg-white border-2 border-[#71B1A5]/30 flex items-center justify-center mb-5 flex-shrink-0 shadow-sm\">\n              <span class=\"font-serif text-[#71B1A5] text-xl leading-none\">4</span>\n            </div>\n            <h3 class=\"font-serif text-lg text-[#27252B] mb-2\">Cierre y autonomía</h3>\n            <p class=\"text-[#27252B]/50 text-xs leading-relaxed font-light\">\n              El objetivo final es que no nos necesites. Consolidamos los cambios,\n              reforzamos tus recursos y cerramos el proceso cuando estés listo.\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============================================================\n         PREGUNTAS FRECUENTES (FAQ) — SEO semántico enriquecido\n    ============================================================ -->\n    <section aria-labelledby=\"faq-titulo\" class=\"py-20 md:py-28 px-8 md:px-16 lg:px-24\">\n      <div class=\"max-w-4xl mx-auto\">\n\n        <div class=\"flex items-center gap-3 mb-12\">\n          <div class=\"w-6 h-px bg-[#71B1A5]\"></div>\n          <h2 id=\"faq-titulo\" class=\"font-serif text-3xl md:text-4xl text-[#27252B]\">\n            Preguntas frecuentes\n          </h2>\n        </div>\n\n        <div class=\"space-y-0 divide-y divide-[#27252B]/8\">\n          <details\n            v-for=\"(item, i) in faqs\"\n            :key=\"i\"\n            class=\"group py-6\"\n          >\n            <summary class=\"flex items-center justify-between cursor-pointer list-none gap-6\">\n              <h3 class=\"font-serif text-lg md:text-xl text-[#27252B] leading-snug group-open:text-[#71B1A5] transition-colors duration-300\">\n                {{ item.q }}\n              </h3>\n              <div class=\"w-7 h-7 flex-shrink-0 border border-[#27252B]/15 flex items-center justify-center group-open:border-[#71B1A5]/40 group-open:bg-[#71B1A5]/8 transition-all duration-300\">\n                <svg class=\"w-3 h-3 text-[#27252B]/40 group-open:text-[#71B1A5] group-open:rotate-45 transition-all duration-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 4v16m8-8H4\"/>\n                </svg>\n              </div>\n            </summary>\n            <p class=\"mt-4 text-[#27252B]/55 text-sm leading-relaxed font-light pr-12\">\n              {{ item.a }}\n            </p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============================================================\n         CTA FINAL\n    ============================================================ -->\n    <section aria-label=\"Reservar cita en psicología Granada\" class=\"py-20 md:py-24 bg-[#27252B] px-8 md:px-16\">\n      <div class=\"max-w-3xl mx-auto text-center\">\n\n        <div class=\"flex items-center justify-center gap-4 mb-8\">\n          <div class=\"h-px w-10 bg-[#71B1A5]/50\"></div>\n          <div class=\"w-1.5 h-1.5 rounded-full bg-[#71B1A5]\"></div>\n          <div class=\"h-px w-10 bg-[#71B1A5]/50\"></div>\n        </div>\n\n        <h2 class=\"font-serif text-3xl md:text-4xl text-white leading-tight mb-5\">\n          El primer paso es\n          <span class=\"italic text-[#71B1A5]\"> el más importante</span>\n        </h2>\n        <p class=\"text-white/45 text-base leading-relaxed mb-10 font-light\">\n          Si tienes dudas sobre qué modalidad terapéutica es la más adecuada para ti,\n          escríbenos. Te orientamos sin compromiso.\n        </p>\n\n        <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n          <NuxtLink\n            to=\"/contacto\"\n            class=\"inline-flex items-center gap-3 bg-[#71B1A5] text-white px-9 py-4 text-sm tracking-[0.15em] uppercase font-medium hover:bg-[#5a9a8e] transition-all duration-300 shadow-xl shadow-[#71B1A5]/25 w-full sm:w-auto justify-center\"\n          >\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"\n                d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\"/>\n            </svg>\n            Reservar primera cita\n          </NuxtLink>\n          <NuxtLink\n            to=\"/conocenos\"\n            class=\"inline-flex items-center gap-3 border border-white/20 text-white px-9 py-4 text-sm tracking-[0.15em] uppercase font-medium hover:border-[#71B1A5] hover:text-[#71B1A5] transition-all duration-300 w-full sm:w-auto justify-center\"\n          >\n            Conocer al equipo\n          </NuxtLink>\n        </div>\n      </div>\n    </section>\n\n  </main>\n</template>\n\n<script setup>\nconst faqs = [\n  {\n    q: '¿Cuánto dura una sesión de psicoterapia y con qué frecuencia se realizan?',\n    a: 'Las sesiones tienen una duración estándar de 50 minutos. La frecuencia habitual durante la fase activa del proceso es semanal, aunque puede ajustarse a quincenal en fases de consolidación o cuando las circunstancias personales así lo requieran. Lo definimos juntos en la primera consulta.',\n  },\n  {\n    q: '¿Cómo sé qué tipo de terapia es la más adecuada para mí?',\n    a: 'No es necesario que lo sepas de antemano. En la primera consulta realizamos una evaluación exhaustiva de tu situación y te explicamos qué enfoque y qué profesional de nuestro equipo se adapta mejor a lo que necesitas. Esa orientación es siempre personalizada y sin compromiso.',\n  },\n  {\n    q: '¿Ofrecéis sesiones online además de presenciales?',\n    a: 'Sí. Todas nuestras especialidades están disponibles en formato online mediante videollamada segura y cifrada. Muchos de nuestros pacientes de fuera de Granada o con dificultades de desplazamiento valoran especialmente esta modalidad, que tiene la misma eficacia que la presencial para la mayoría de los procesos.',\n  },\n  {\n    q: '¿La primera consulta es de pago?',\n    a: 'Sí, la primera sesión tiene coste regular. No creemos en las \"sesiones gratuitas\" que en realidad son entrevistas de venta: desde el primer momento te ofrecemos ya una atención profesional real, con escucha activa, evaluación y orientación sobre los pasos a seguir.',\n  },\n  {\n    q: '¿Con qué confidencialidad trabajan?',\n    a: 'Todo lo que compartes en consulta está protegido por el secreto profesional y la legislación vigente de protección de datos (RGPD). Ninguna información es compartida con terceros sin tu consentimiento expreso, salvo en los supuestos legalmente previstos que te explicamos en el consentimiento informado que firmas al inicio del proceso.',\n  },\n]\n\nuseSeoMeta({\n  title: 'Psicoterapia y Especialidades Clínicas en Granada | La Seda',\n  description:\n    'Terapia individual para adultos, terapia infanto-juvenil, de pareja y Constelaciones Familiares en Granada. Psicólogos colegiados con enfoque integrativo en el Centro La Seda.',\n  ogTitle: 'Terapias Clínicas en Granada · La Seda Psicología',\n  ogDescription:\n    'Ansiedad, depresión, terapia de pareja, acompañamiento infanto-juvenil y Constelaciones Familiares. Descubre nuestras especialidades en el Centro de Psicología La Seda, Granada.',\n  ogImage: 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=1200&q=85',\n  ogType: 'website',\n  robots: 'index, follow',\n})\n\nuseHead({\n  script: [\n    {\n      type: 'application/ld+json',\n      innerHTML: JSON.stringify({\n        '@context': 'https://schema.org',\n        '@type': 'FAQPage',\n        mainEntity: [\n          {\n            '@type': 'Question',\n            name: '¿Cuánto dura una sesión de psicoterapia y con qué frecuencia se realizan?',\n            acceptedAnswer: {\n              '@type': 'Answer',\n              text: 'Las sesiones tienen una duración estándar de 50 minutos. La frecuencia habitual durante la fase activa del proceso es semanal, aunque puede ajustarse a quincenal en fases de consolidación.',\n            },\n          },\n          {\n            '@type': 'Question',\n            name: '¿Cómo sé qué tipo de terapia es la más adecuada para mí?',\n            acceptedAnswer: {\n              '@type': 'Answer',\n              text: 'En la primera consulta realizamos una evaluación exhaustiva y te orientamos hacia el enfoque y profesional más adecuado sin compromiso.',\n            },\n          },\n          {\n            '@type': 'Question',\n            name: '¿Ofrecéis sesiones online además de presenciales?',\n            acceptedAnswer: {\n              '@type': 'Answer',\n              text: 'Sí. Todas nuestras especialidades están disponibles en formato online mediante videollamada segura y cifrada.',\n            },\n          },\n        ],\n      }),\n    },\n  ],\n})\n</script>"],"version":3}